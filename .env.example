# Copy this file to .env and paste your Google Maps Platform key.
# The key needs Maps JavaScript API + Routes API enabled and
# http://localhost:5173/* in its website restrictions.
GOOGLE_MAPS_API_KEY=your-api-key-here

# Optional: your own Map ID (Advanced Markers need one). Defaults to DEMO_MAP_ID.
# VITE_GOOGLE_MAP_ID=
